# رمز ورود به پنل (اگه ندی، پیش‌فرض admin123 می‌مونه — حتماً عوضش کن)
ADMIN_PASSWORD=change-me-123

# اختیاری: توکن ربات تلگرام (از @BotFather بگیر). اگه خالی بذاری، ربات خاموش می‌مونه
TELEGRAM_BOT_TOKEN=

# اختیاری: آیدی عددی ادمین‌ها (از @userinfobot بگیر)، چند تا رو با کاما جدا کن
TELEGRAM_ADMIN_IDS=

# اختیاری: اگه دامنه‌ی سفارشی خودت رو داری، اینجا بذار (بدون https://)
# اگه خالی باشه، از RAILWAY_PUBLIC_DOMAIN که Railway خودش می‌ده استفاده می‌شه
PUBLIC_DOMAIN=

# اختیاری: کلید امنیتی ثابت برای هش رمز عبور (اگه ندی، خودکار می‌سازه و روی دیسک ذخیره می‌کنه)
SECRET_KEY=

# مسیر ذخیره‌ی state.json — روی Railway یک Volume به همین مسیر وصل کن تا دیتا پاک نشه
DATA_DIR=/data
